# Contact delivery is disabled unless explicitly enabled with valid server config.
# These are runtime server variables, never VITE_ browser variables.
# Keep disabled in development/preview. See docs/contact-setup.md.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Comma-separated exact origins, without a trailing slash or path.
CONTACT_ALLOWED_ORIGINS=
